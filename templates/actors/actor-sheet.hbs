<div class='layout'>
  {{#if statusRibbonText}}
    <div class='status-ribbon'>{{statusRibbonText}}</div>
  {{/if}}
  <!-- LEFT: avatar + quick actions (optional) -->
  <section class='avatar card'>
    <div class='portrait'>
      <img
        src='{{portraitSrc}}'
        data-action='editImage'
        data-edit='img'
        alt='{{actor.name}}'
        title='{{localize "LH.ui.changePortrait"}}'
      />
      <div class='portrait-overlay'><i class='fas fa-camera'></i>&nbsp;{{localize 'LH.ui.photo'}}</div>
    </div>
    <div>
      <div class='section-title section-title-with-buttons'>
        <div>
          {{localize (concat 'LH.ui.background' item.system.state)}}</div>
        <div class='flexrow actions-row'>
          <a data-action='rest' title='{{localize "LH.core.rest"}}'>
            <i class='fas fa-bed'></i>
          </a>
          <a data-action='dof' title='{{localize "LH.core.dofXs"}}'>
            <i class='fas fa-dice-d6'></i>
          </a>
        </div>

      </div>
      <input class='big-input' type='text' name='system.identity.background' value='{{system.identity.background}}' />
    </div>
  </section>

  <!-- RIGHT: name + tiles -->
  <section class='hero card'>
    <input
      class='big-input name-input'
      type='text'
      name='name'
      value='{{actor.name}}'
      placeholder='{{localize "LH.ui.namePlaceholder"}}'
    />
    <div class='tiles'>
      <!-- HP -->
      <div class='tile'>
        <div class='pill'>{{localize (concat 'LH.ui.hp' item.system.state)}}</div>
        <div class='pair'>
          <input
            class='num chip'
            data-deprived='{{system.status.deprived}}'
            type='number'
            name='system.defense.hp'
            value='{{system.defense.hp}}'
            {{disabled system.status.deprived}}
          />
          /
          <input class='num chip' type='number' name='system.defense.hpMax' value='{{system.defense.hpMax}}' />
        </div>
      </div>

      <!-- Deprived -->
      <div class='tile'>
        <div class='pill'>{{localize (concat 'LH.ui.deprived' item.system.state)}}</div>
        <div class='deprived'>
          <label class='deprived-checkbox'>
            <input
              class='checkbox'
              type='checkbox'
              name='system.status.deprived'
              {{checked system.status.deprived}}
              {{disabled (gt system.inventory.slotsUsed 10)}}
            />
            <span class='checkbox-box' aria-hidden='true'></span>
          </label>
        </div>
      </div>

      <!-- STR -->
      <div class='tile'>
        <div
          class='pill rollable'
          role='button'
          tabindex='0'
          data-action='rollAttr'
          data-key='str'
          title='{{localize "LH.ui.rollStrength"}}'
        >
          <i class='fas fa-dice-d20' aria-hidden='true'></i><span>{{localize
              (concat 'LH.attr.short.str' item.system.state)
            }}</span>
        </div>
        <div class='pair'>
          <input
            class='num chip'
            type='number'
            name='system.attributes.str.value'
            value='{{system.attributes.str.value}}'
          />
          /
          <input
            class='num chip'
            type='number'
            name='system.attributes.str.base'
            value='{{system.attributes.str.base}}'
          />
        </div>
      </div>

      <!-- Armor -->
      <div class='tile'>
        <div class='pill'>
          {{localize (concat 'LH.ui.armor' item.system.state)}}
          {{#if autoArmorCalculation}}
            <i
              class='fa-solid fa-gear armor-auto-icon'
              aria-label='{{localize "LH.ui.autoArmorHint"}}'
              title='{{localize "LH.ui.autoArmorHint"}}'
            ></i>
          {{/if}}
        </div>
        {{#if autoArmorCalculation}}
          <input
            class='num chip'
            type='number'
            name='system.defenses.armor'
            value='{{system.defenses.armor}}'
            readonly
          />
        {{else}}
          <input class='num chip' type='number' name='system.defenses.armor' value='{{system.defenses.armor}}' />
        {{/if}}
      </div>

      <!-- DEX -->
      <div class='tile'>
        <div
          class='pill rollable'
          role='button'
          tabindex='0'
          data-action='rollAttr'
          data-key='dex'
          title='{{localize "LH.ui.rollDexterity"}}'
        >
          <i class='fas fa-dice-d20' aria-hidden='true'></i><span>{{localize
              (concat 'LH.attr.short.dex' item.system.state)
            }}</span>
        </div>
        <div class='pair'>
          <input
            class='num chip'
            type='number'
            name='system.attributes.dex.value'
            value='{{system.attributes.dex.value}}'
          />
          /
          <input
            class='num chip'
            type='number'
            name='system.attributes.dex.base'
            value='{{system.attributes.dex.base}}'
          />
        </div>
      </div>

      <!-- Stability -->
      <div class='tile'>
        <div class='pill'>{{localize (concat 'LH.ui.stability' item.system.state)}}</div>
        <input
          class='num chip'
          type='number'
          name='system.defenses.selfControl'
          value='{{system.defenses.selfControl}}'
        />
      </div>

      <!-- CTRL -->
      <div class='tile'>
        <div
          class='pill rollable'
          role='button'
          tabindex='0'
          data-action='rollAttr'
          data-key='con'
          title='{{localize "LH.ui.rollControl"}}'
        >
          <i class='fas fa-dice-d20' aria-hidden='true'></i><span>{{localize
              (concat 'LH.attr.short.ctrl' item.system.state)
            }}</span>
        </div>
        <div class='pair'>
          <input
            class='num chip'
            type='number'
            name='system.attributes.con.value'
            value='{{system.attributes.con.value}}'
          />
          /
          <input
            class='num chip'
            type='number'
            name='system.attributes.con.base'
            value='{{system.attributes.con.base}}'
          />
        </div>
      </div>

      <!-- Cash -->
      <div class='tile'>
        <div class='pill'>{{localize (concat 'LH.ui.cash' item.system.state)}}</div>
        <input class='num chip' type='number' name='system.inventory.money' value='{{system.inventory.money}}' />
      </div>
      {{#if showLuck}}
        <!-- Luck -->
        <div class='tile'>
          <div
            class='pill rollable'
            role='button'
            tabindex='0'
            data-action='rollAttr'
            data-key='luck'
            title='{{localize "LH.ui.rollLuck"}}'
          >
            <i class='fas fa-dice-d20' aria-hidden='true'></i><span>{{localize
                (concat 'LH.attr.short.luck' item.system.state)
              }}</span>
          </div>
          <div class='pair'>
            <input
              class='num chip'
              type='number'
              name='system.attributes.luck.value'
              value='{{system.attributes.luck.value}}'
            />
            /
            <input
              class='num chip'
              type='number'
              name='system.attributes.luck.base'
              value='{{system.attributes.luck.base}}'
            />
          </div>
        </div>
      {{/if}}
    </div>
    <div class='line'></div>
    <div class='section-title'>{{localize (concat 'LH.ui.actions' item.system.state)}}</div>

    <div class='actions actions--segmented'>
      <!-- Damage -->
      <div class='action-group'>
        <div class='seg seg-label'>
          <i class='fas fa-burst' aria-hidden='true'></i><span>{{localize
              (concat 'LH.core.damage' item.system.state)
            }}</span>
        </div>
        <input class='seg seg-input' name='damageAmount' type='number' value='1' min='0' step='1' />
        <button
          type='button'
          class='seg seg-btn'
          data-action='applyDamage'
          title='{{localize "LH.core.apply"}}'
          aria-disabled='{{eq disableDamageAction true}}'
          {{disabled disableDamageAction}}
        >
          <i class='fas fa-check' aria-hidden='true'></i>
        </button>
      </div>

      <!-- Stress -->
      <div class='action-group'>
        <div class='seg seg-label'>
          <i class='fas fa-brain' aria-hidden='true'></i><span>{{localize
              (concat 'LH.core.stress' item.system.state)
            }}</span>
        </div>
        <input class='seg seg-input' name='stressAmount' type='number' value='1' min='0' step='1' />
        <button
          type='button'
          class='seg seg-btn'
          data-action='applyStress'
          title='{{localize "LH.core.apply"}}'
          aria-disabled='{{eq disableStressAction true}}'
          {{disabled disableStressAction}}
        >
          <i class='fas fa-check' aria-hidden='true'></i>
        </button>
      </div>
    </div>
  </section>

  <!-- TABS -->
  <nav class='tabs' data-group='primary'>
    <a class='item {{tabClasses.items}}' data-action='tab' data-group='primary' data-tab='items'>{{localize
        (concat 'LH.ui.tabs.items' item.system.state)
      }}</a>
    <a class='item {{tabClasses.description}}' data-action='tab' data-group='primary' data-tab='description'>{{localize
        (concat 'LH.ui.tabs.description' item.system.state)
      }}</a>
    <a class='item {{tabClasses.notes}}' data-action='tab' data-group='primary' data-tab='notes'>{{localize
        (concat 'LH.ui.tabs.notes' item.system.state)
      }}</a>
    {{#if @root.canEditItems}}
      <a class='item {{tabClasses.log}}' data-action='tab' data-group='primary' data-tab='log'>{{localize
          (concat 'LH.ui.tabs.log' item.system.state)
        }}</a>
    {{/if}}
  </nav>

  <section class='sheet-body'>
    <!-- ITEMS TAB -->
    <div class='tab card {{tabClasses.items}}' data-group='primary' data-tab='items'>
      <div class='inv-head'>
        <div class='section-title'>{{localize (concat 'LH.ui.inventory' item.system.state)}}</div>
        <div class='inv-meta'>
          <div class='inv-sort' data-select-anchor title='{{localize "LH.ui.sort"}}'>
            {{#if showInventorySortDirection}}
              <button
                type='button'
                class='inv-sort-direction'
                data-action='inventorySortDirection'
                title='{{inventorySortDirectionTitle}}'
                aria-label='{{inventorySortDirectionTitle}}'
              >
                <i class='{{inventorySortDirectionIcon}}' aria-hidden='true'></i>
              </button>
            {{else}}
              <span class='inv-sort-icon' aria-hidden='true'><i class='fas fa-sort'></i></span>
            {{/if}}
            <button
              type='button'
              class='inv-sort-select'
              popovertarget='{{rootId}}-inventory-sort'
              aria-haspopup='menu'
              aria-expanded='false'
              aria-controls='{{rootId}}-inventory-sort'
              aria-label='{{localize "LH.ui.sort"}}: {{inventorySortLabel}}'
            >
              <span>{{inventorySortLabel}}</span><i class='fas fa-chevron-down' aria-hidden='true'></i>
            </button>
            <div id='{{rootId}}-inventory-sort' class='lh lh-select-menu' popover='auto' role='menu' aria-label='{{localize "LH.ui.sort"}}'>
              {{#each inventorySortOptions as |option|}}
                <button type='button' role='menuitemradio' data-value='{{option.value}}' aria-checked='{{ifThen option.selected "true" "false"}}' tabindex='-1'>
                  <span>{{option.label}}</span><i class='fas fa-check' aria-hidden='true'></i>
                </button>
              {{/each}}
            </div>
          </div>
          <div
            class='inv-slots'
            role='group'
            aria-label='{{localize "LH.ui.slots"}}'
            title='{{localize "LH.ui.slots"}}'
            data-over='{{gt system.inventory.slotsUsed system.inventory.slotsMax}}'
          >
            <i class='fas fa-bag-shopping' aria-hidden='true'></i>
            <span><strong>{{system.inventory.slotsUsed}}</strong> / {{system.inventory.slotsMax}}</span>
          </div>
        </div>
      </div>

      {{#each items as |item|}}
        <div>
          <div
            class='inv-row'
            data-equipped='{{and
              (or (eq item.type "armor") (eq item.type "weapon") (eq item.type "spell"))
              item.system.equipped
            }}'
            data-item-id='{{item._id}}'
            data-item-type='{{item.type}}'
            data-sortable='{{@root.isManualInventorySort}}'
          >
            <div class='inv-carry'>
              {{#if @root.isManualInventorySort}}
                <span
                  class='inv-drag-handle'
                  data-item-id='{{item._id}}'
                  draggable='true'
                  title='{{localize "LH.ui.dragToReorder"}}'
                ><i class='fas fa-grip-lines-vertical'></i></span>
              {{/if}}
              <img
                class='inv-image'
                src='{{item.img}}'
                alt=''
                title='{{localize (concat "TYPES.Item." item.type)}}'
                loading='lazy'
                draggable='false'
              />
            </div>

            <div class='inv-main'>
              {{#if item.hasDescription}}
                <button
                  type='button'
                  class='entity-link inv-name-toggle'
                  data-action='toggleDescription'
                  data-item-id='{{item._id}}'
                  aria-expanded='{{item.descriptionExpanded}}'
                  title='{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})'
                >
                  <span class='inv-name-label'>{{item.name}}</span>
                </button>
              {{else}}
                <span class='entity-link inv-name-static' title='{{item.name}} ({{localize (concat "TYPES.Item." item.type)}})'>{{item.name}}</span>
              {{/if}}
              {{#unless item.system.ignoreSlots}}
                <span class='item-slots' title='{{localize "LH.ui.slots"}}'>
                  {{repeat '●' item.system.slotSize}}
                </span>
              {{/unless}}
            </div>

            <div class='inv-grip'>
              {{#if (eq item.type 'weapon')}}
                <span
                  class='tw-text-xs tw-muted'
                  title='{{localize (ifThen item.system.twoHanded "LH.equipment.twoHanded" "LH.equipment.oneHanded")}}'
                >{{#if item.system.twoHanded}}{{localize 'LH.equipment.twoHandedShort'}}{{else}}{{localize
                      'LH.equipment.oneHandedShort'
                    }}{{/if}}</span>
              {{/if}}
            </div>

            <div class='inv-actions'>
              <div class='inv-stat'>
                <!-- WEAPON DAMAGE -->
                {{#if (and (or (eq item.type 'weapon') (eq item.type 'spell')) item.system.damageDie)}}
                  <a
                    class='icon-link die-link {{ifThen item.attackDisabled "die-disabled" ""}}'
                    role='button'
                    tabindex='{{ifThen item.attackDisabled "-1" "0"}}'
                    aria-disabled='{{item.attackDisabled}}'
                    data-action='{{ifThen item.attackDisabled "" "useItem"}}'
                    data-item-id='{{item._id}}'
                    title='{{item.attackTitle}}'
                  >
                    <span class='die-text'>{{item.system.damageDie}}</span>
                  </a>
                {{else if (or (eq item.type 'weapon') (eq item.type 'spell'))}}
                  <span class='die-text die-disabled' title='{{localize "LH.ui.noDamageDie"}}'>—</span>
                {{/if}}

                <!-- GEAR -->
                {{#if (and (eq item.type 'gear') (gt item.system.usesMax 0))}}
                  <a data-action='useItem' data-item-id='{{item._id}}'><i class='fas fa-bolt fa-xs'></i></a>
                  <span class='die-text'>{{item.system.usesCurrent}} / {{item.system.usesMax}}</span>
                {{/if}}

                <!-- ARMOR -->
                {{#if (eq item.type 'armor')}}
                  <span class='die-text'> <i class='fas fa-shield-alt'></i> {{item.system.armorValue}}</span>
                {{/if}}
              </div>

              <!-- EQUIP -->
              {{#if (eq item.type 'weapon')}}
                <a
                  data-action='toggleEquip'
                  class='equip-toggle'
                  data-hand='main'
                  data-equipped='{{item.mainHandEquipped}}'
                  role='button'
                  tabindex='0'
                  aria-pressed='{{item.mainHandEquipped}}'
                  aria-label='{{localize "LH.equipment.mainHand"}}'
                  title='{{localize (ifThen item.system.twoHanded "LH.equipment.bothHands" "LH.equipment.mainHand")}}'
                ><i class='fas fa-hand-fist' aria-hidden='true'></i></a>
                <a
                  data-action='toggleEquip'
                  class='equip-toggle'
                  data-hand='off'
                  data-equipped='{{item.offHandEquipped}}'
                  role='button'
                  tabindex='0'
                  aria-pressed='{{item.offHandEquipped}}'
                  aria-label='{{localize "LH.equipment.offHand"}}'
                  title='{{localize (ifThen item.system.twoHanded "LH.equipment.bothHands" "LH.equipment.offHand")}}'
                ><i class='fas fa-hand' aria-hidden='true'></i></a>
              {{else if (or (eq item.type 'armor') (eq item.type 'spell'))}}
                <a
                  data-action='toggleEquip'
                  class='equip-toggle'
                  data-equipped='{{item.system.equipped}}'
                  role='button'
                  tabindex='0'
                  aria-pressed='{{item.system.equipped}}'
                  aria-label='{{localize "LH.core.equipped"}}'
                  title='{{localize "LH.core.equipped"}}'
                ><i
                    class='fas {{ifThen (eq item.type "spell") "fa-wand-magic-sparkles" "fa-hand"}}'
                    aria-hidden='true'
                  ></i></a>
              {{/if}}

              <!-- GM ACTION -->
              {{#if @root.canEditItems}}
                <a
                  class='icon-link item-edit'
                  data-action='editItem'
                  role='button'
                  tabindex='0'
                  data-item-id='{{item._id}}'
                  title='{{localize "LH.core.edit"}}'
                ><i class='fas fa-edit'></i></a>
              {{/if}}
              {{#if
                (or
                  (eq item.type 'weapon')
                  (eq item.type 'spell')
                  (eq item.type 'gear')
                  (eq item.type 'armor')
                  (eq item.type 'artifact')
                  @root.canEditItems
                )
              }}
                <a
                  class='icon-link item-delete'
                  data-action='deleteItem'
                  role='button'
                  tabindex='0'
                  data-item-id='{{item._id}}'
                  title='{{localize "LH.core.delete"}}'
                ><i class='fas fa-trash'></i></a>
              {{/if}}
            </div>
          </div>
          {{#if item.hasDescription}}
            {{#if item.descriptionExpanded}}
              <div class='inv-desc' data-item-id='{{item._id}}'>
                <div class='inv-desc-inner'>{{{item.enrichedDescription}}}</div>
              </div>
            {{else}}
              <div class='inv-desc is-collapsed' data-item-id='{{item._id}}'>
                <div class='inv-desc-inner'>{{{item.enrichedDescription}}}</div>
              </div>
            {{/if}}
          {{/if}}
        </div>
      {{/each}}
    </div>

    <!-- DESCRIPTION TAB -->
    <div class='tab card {{tabClasses.description}}' data-group='primary' data-tab='description'>
      <div class='section-title'>{{localize (concat 'LH.ui.tabs.description' item.system.state)}}</div>
      <prose-mirror
        name='system.identity.description'
        value='{{system.identity.description}}'
        data-document-uuid='{{actor.uuid}}'
        toggled
      >{{{enrichedDescription}}}</prose-mirror>
    </div>

    <!-- NOTES TAB -->
    <div class='tab card {{tabClasses.notes}}' data-group='primary' data-tab='notes'>
      <div class='section-title'>{{localize 'LH.ui.tabs.notes'}}</div>
      <prose-mirror
        name='system.notes'
        value='{{system.notes}}'
        data-document-uuid='{{actor.uuid}}'
        toggled
      >{{{enrichedNotes}}}</prose-mirror>
    </div>

    <!-- LOG TAB -->
    <div class='tab card {{tabClasses.log}}' data-group='primary' data-tab='log'>
      <div class='section-title'>{{localize (concat 'LH.ui.tabs.log' item.system.state)}}</div>

      {{#if @root.canEditItems}}
        {{#if actor.flags.liminal-horror.gmLog}}
          <ul class='gm-log'>
            {{#each actor.flags.liminal-horror.gmLog as |entry|}}
              <li>
                <div>
                  <b>{{entry.actorName}}</b>
                  ({{entry.userName}}) —
                  {{entry.timestamp}}
                </div>
                <ul class='gm-log-item'>
                  {{#each entry.changes as |c|}}
                    <li>
                      <code>{{c.key}}</code>:
                      <span style='color: red'>{{c.from}}</span>
                      →
                      <span style='color: green'>{{c.to}}</span>
                    </li>
                  {{/each}}
                </ul>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p><i>{{localize 'LH.ui.noChangesLogged'}}</i></p>
        {{/if}}
      {{else}}
        <p><i>{{localize 'LH.ui.gmOnly'}}</i></p>
      {{/if}}
    </div>
  </section>
</div>
